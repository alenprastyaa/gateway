PORT=1300

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=landing_gateway
DB_USER=root
DB_PASSWORD=

# Must be a public HTTPS domain in production (used to build iPaymu returnUrl/notifyUrl).
PUBLIC_BASE_URL=https://landing.example.com

IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_BASE_URL=https://my.ipaymu.com

JWT_SECRET=

# 32-byte hex key used to encrypt target_vps.internal_secret at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=
